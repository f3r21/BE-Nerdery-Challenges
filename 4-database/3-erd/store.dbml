Enum order_status {
  pending
  paid
  processing
  shipped
  delivered
  cancelled
}

Table user_auth_data {
  id integer [primary key]
  email varchar [unique]
  password_hash varchar
  first_name varchar
  last_name varchar
  role_id integer [not null]
  reset_token varchar [null]
  reset_token_expires_at timestamp [null]
  created_at timestamp
}
Table user_role {
  id integer [primary key]
  name varchar // Manager, Client, Delivery
}

Table products {
  id integer [primary key]
  name varchar
  description text
  is_active boolean
  created_at timestamp
}

Table product_variants {
  id integer [primary key]
  product_id integer [not null]
  size varchar
  color varchar
  stock integer
  price numeric
}

Table categories {
  id integer [primary key]
  name varchar
}

Table product_categories {
  product_id integer
  category_id integer
  Indexes {
    (product_id, category_id) [pk]
  }
}

Table product_images {
  id integer [primary key]
  product_id integer [not null]
  image_url varchar
}

Table shopping_carts {
  id integer [primary key]
  user_id integer [unique, not null] 
  created_at timestamp
}

Table shopping_cart_items {
  id integer [primary key]
  cart_id integer [not null]
  product_variant_id integer [not null]
  quantity integer
}

Table orders {
  id integer [primary key]
  status order_status [not null]
  user_id integer [not null]
  promo_code_id integer [null]
  discount_amount numeric [null]
  subtotal_amount numeric(10,2) [not null]
  total_amount numeric(10,2) [not null]
  assigned_delivery_person_id integer [null]
  created_at timestamp
}

Table order_items {
  id integer [primary key]
  order_id integer [not null]
  product_variant_id integer [not null]
  quantity integer
  price_at_purchase numeric
}

Table order_status_history {
  id integer [primary key]
  order_id integer [not null]
  status order_status [not null]
  changed_at timestamp
}

Table order_payments {
  id integer [primary key]
  order_id integer [not null]
  payment_method varchar
  stripe_reference varchar [unique]
  amount numeric
  status varchar
  created_at timestamp
}

Table product_likes {
  user_id integer
  product_id integer
  Indexes {
    (user_id, product_id) [pk]
  }
}

Table promo_codes {
  id integer [primary key]
  code varchar [unique]
  discount_type varchar
  discount_value numeric
  expiration_date timestamp
  usage_limit integer
  min_purchase_amount numeric [null]
  is_active boolean
}

Table refresh_tokens {
  id integer [primary key]
  user_id integer [not null]
  token_hash varchar [unique]
  device_name varchar [null]
  expires_at timestamptz
  created_at timestamptz
} 

Ref: refresh_tokens.user_id > user_auth_data.id
Ref: user_auth_data.role_id > user_role.id
Ref: product_variants.product_id > products.id
Ref: product_categories.product_id > products.id
Ref: product_categories.category_id > categories.id
Ref: product_images.product_id > products.id
Ref: user_auth_data.id - shopping_carts.user_id
Ref: shopping_cart_items.cart_id > shopping_carts.id
Ref: shopping_cart_items.product_variant_id > product_variants.id
Ref: orders.user_id > user_auth_data.id
Ref: orders.promo_code_id > promo_codes.id
Ref: orders.assigned_delivery_person_id > user_auth_data.id
Ref: order_items.order_id > orders.id
Ref: order_items.product_variant_id > product_variants.id
Ref: order_status_history.order_id > orders.id
Ref: order_payments.order_id > orders.id
Ref: product_likes.user_id > user_auth_data.id
Ref: product_likes.product_id > products.id
